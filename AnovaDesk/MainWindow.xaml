<Window x:Class="AnovaDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AnovaDesk" Height="780" Width="1020" MinHeight="640" MinWidth="900"
        Background="#12141A" Foreground="#E9ECEF"
        FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">

    <Window.Resources>
        <SolidColorBrush x:Key="CardBg" Color="#1B1F27"/>
        <SolidColorBrush x:Key="CardEdge" Color="#2A303B"/>
        <SolidColorBrush x:Key="Accent" Color="#FF7A45"/>
        <SolidColorBrush x:Key="Muted" Color="#98A2B3"/>

        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#E9ECEF"/>
            <Setter Property="Background" Value="#252A34"/>
            <Setter Property="BorderBrush" Value="#333A47"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2F3644"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="#1A0E06"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF8F62"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#12151B"/>
            <Setter Property="Foreground" Value="#E9ECEF"/>
            <Setter Property="BorderBrush" Value="#333A47"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="CaretBrush" Value="#E9ECEF"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#12151B"/>
            <Setter Property="Foreground" Value="#E9ECEF"/>
            <Setter Property="BorderBrush" Value="#333A47"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="CaretBrush" Value="#E9ECEF"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#E9ECEF"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" Background="Transparent" CornerRadius="5"
                                Padding="{TemplateBinding Padding}" Margin="0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#232935"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#33241B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardEdge}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition x:Name="LogRow" Height="0"/>
        </Grid.RowDefinitions>

        <!-- ================= header ================= -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,26,0">
                <TextBlock Text="AnovaDesk" Style="{StaticResource H1}"/>
                <TextBlock Text="Windows controller for Anova Wi-Fi Precision Cookers"
                           Foreground="{StaticResource Muted}" FontSize="11"/>
                <CheckBox x:Name="AdvancedToggle" Content="Advanced view" Margin="0,7,0,0"
                          Foreground="#98A2B3" FontSize="11" IsChecked="False"
                          ToolTip="Show raw device state and websocket traffic"
                          Checked="Advanced_Toggled" Unchecked="Advanced_Toggled"/>
            </StackPanel>

            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <PasswordBox x:Name="TokenBox" Grid.Column="0" VerticalAlignment="Center"
                             PasswordChar="&#9679;" ToolTip="Anova personal access token (starts with anova-)"/>

                <Button x:Name="ConnectButton" Grid.Column="1" Margin="8,0,0,0"
                        Content="Connect" Style="{StaticResource Primary}" Click="Connect_Click"/>
                <Button x:Name="ForgetButton" Grid.Column="2" Margin="8,0,0,0"
                        Content="Forget token" Click="Forget_Click"/>

                <Border Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center"
                        Background="#1B1F27" BorderBrush="#2A303B" BorderThickness="1"
                        CornerRadius="20" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#6B7280"
                                 VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock x:Name="StatusPill" Text="Offline" FontSize="12"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ================= content ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- devices -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="COOKERS" Style="{StaticResource Label}"/>
                    <TextBlock x:Name="DeviceHint" DockPanel.Dock="Bottom" TextWrapping="Wrap"
                               Foreground="{StaticResource Muted}" FontSize="11" Margin="2,10,2,0"
                               Text="Paste your token and press Connect."/>
                    <ListBox x:Name="DeviceList" Margin="0,4,0,0"
                             SelectionChanged="DeviceList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#E9ECEF"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                    <Setter Property="Foreground" Value="#5B6371"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- controls -->
            <Border x:Name="ControlCard" Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition x:Name="StateRowDef" Height="0"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- live readout -->
                    <StackPanel Grid.Row="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                            <TextBlock x:Name="TempText" Text="--.-" FontSize="60" FontWeight="Light"
                                       Foreground="#FFFFFF" VerticalAlignment="Bottom"/>
                            <TextBlock x:Name="TempUnitText" Text="°C" FontSize="24" FontWeight="Light"
                                       Foreground="{StaticResource Muted}" Margin="8,0,0,14"
                                       VerticalAlignment="Bottom"/>
                        </StackPanel>
                        <TextBlock x:Name="StatusText" Text="No device selected."
                                   Foreground="{StaticResource Muted}" Margin="2,-4,0,0"/>
                        <TextBlock x:Name="AlertText" Text="" Foreground="#FF6B6B" FontSize="12"
                                   Margin="2,5,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                        <TextBlock x:Name="TargetText" Text="" Foreground="{StaticResource Accent}"
                                   FontSize="12" Margin="2,4,0,0"/>
                    </StackPanel>

                    <!-- raw state -->
                    <Border x:Name="StatePanel" Grid.Row="1" Background="#12151B" BorderBrush="#2A303B" BorderThickness="1"
                            CornerRadius="8" Margin="0,14,0,12" Padding="6" Visibility="Collapsed">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="DEVICE STATE" Style="{StaticResource Label}"
                                       Margin="8,6,0,2"/>
                            <ListBox x:Name="StateList">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="190"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Key}"
                                                       Foreground="{StaticResource Muted}" FontSize="12"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                       FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- cook controls -->
                    <StackPanel Grid.Row="2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="TARGET TEMPERATURE" Style="{StaticResource Label}"/>
                                <TextBox x:Name="TargetBox" Text="65.0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="COOK TIME" Style="{StaticResource Label}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="HoursBox" Grid.Column="0" Text="2"/>
                                    <TextBlock Grid.Column="1" Text="h" Margin="6,0,10,0"
                                               VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                                    <TextBox x:Name="MinutesBox" Grid.Column="2" Text="0"/>
                                    <TextBlock Grid.Column="3" Text="m" Margin="6,0,0,0"
                                               VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="4" Width="88">
                                <TextBlock Text="UNIT" Style="{StaticResource Label}"/>
                                <ComboBox x:Name="UnitBox" SelectionChanged="Unit_Changed">
                                    <ComboBoxItem Content="°C"/>
                                    <ComboBoxItem Content="°F"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="Start cook" Style="{StaticResource Primary}" Width="130"
                                    Margin="0,0,8,0" Click="Start_Click" x:Name="StartButton"/>
                            <Button Content="Stop" Width="90" Margin="0,0,8,0" Click="Stop_Click"
                                    x:Name="StopButton"/>
                            <Button x:Name="SteakButton" Content="54.5° steak" Click="Preset_Click" Tag="54.5" Margin="0,0,6,0"/>
                            <Button x:Name="ChickenButton" Content="65° chicken" Click="Preset_Click" Tag="65" Margin="0,0,6,0"/>
                            <Button x:Name="EggsButton" Content="63.5° eggs" Click="Preset_Click" Tag="63.5" Margin="0,0,6,0"/>
                            <Button x:Name="SalmonButton" Content="52° salmon" Click="Preset_Click" Tag="52"/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Shown instead of the controls until a token has been registered. -->
            <Border x:Name="GetStartedCard" Grid.Column="2" Style="{StaticResource Card}" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="580" VerticalAlignment="Center">
                        <TextBlock Text="Connect your cooker" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Margin="0,8,0,22" TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                                   Text="AnovaDesk needs a personal access token from your Anova account. It is a free developer key, not your password, and you can revoke it at any time."/>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="20" Height="20" CornerRadius="10" Background="#33241B" VerticalAlignment="Top">
                                <TextBlock Text="1" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Margin="8,0,0,0" TextWrapping="Wrap"
                                       Text="Install the Anova Oven app on your phone and sign in. It is the only app that creates tokens, and it works for sous vide cookers too."/>
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="20" Height="20" CornerRadius="10" Background="#33241B" VerticalAlignment="Top">
                                <TextBlock Text="2" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Margin="8,0,0,0" TextWrapping="Wrap"
                                       Text="In that app open More in the bottom navigation, then Developer, then Personal Access Tokens."/>
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="20" Height="20" CornerRadius="10" Background="#33241B" VerticalAlignment="Top">
                                <TextBlock Text="3" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Margin="8,0,0,0" TextWrapping="Wrap"
                                       Text="Enter any name (up to 32 characters) and tap Create."/>
                        </Grid>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="20" Height="20" CornerRadius="10" Background="#33241B" VerticalAlignment="Top">
                                <TextBlock Text="4" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Margin="8,0,0,0" TextWrapping="Wrap"
                                       Text="Copy the token. It starts with anova-. Paste it into the token box at the top of this window and press Connect."/>
                        </Grid>

                        <Border Background="#12151B" BorderBrush="#2A303B" BorderThickness="1" CornerRadius="8"
                                Padding="12" Margin="0,4,0,0">
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}"
                                       Text="The token is stored in Windows Credential Manager, never in a file. Up to 10 can exist per Anova account, and any of them can be revoked from the same screen."/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ================= log ================= -->        <Border x:Name="LogPanel" Grid.Row="2" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="10"
                Visibility="Collapsed">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="TRAFFIC" Style="{StaticResource Label}" Margin="6,2,0,4"/>
                <ListBox x:Name="LogList" FontFamily="Consolas" FontSize="11"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
